# =====================================================
# Docker Environment Variables
# =====================================================

# Puerto de la aplicación (donde accederás en el navegador)
APP_PORT=80

# Configuración de MySQL
MYSQL_ROOT_PASSWORD=RootPassword123!
DB_NAME=hospital_patients
DB_USER=hospital_app
DB_PASSWORD=HospitalApp123!

# JWT Secret (CAMBIAR en producción)
# Genera uno con: openssl rand -hex 64
JWT_SECRET=change-this-secret-in-production-to-something-very-long-and-random

# =====================================================
# IMPORTANTE: Cambiar estas contraseñas en producción
# =====================================================
